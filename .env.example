# Port the server listens on
PORT=3000
# SQLite file path (created automatically)
DB_FILE=studio.db
# Studio (admin) account, created on first start if missing.
# If ADMIN_PASSWORD is empty, a random one is generated and printed once.
ADMIN_EMAIL=studio@example.com
ADMIN_PASSWORD=
# Time zone used for "today" in the date rules
APP_TIMEZONE=Asia/Kolkata
# Set to production when served over HTTPS (adds the Secure cookie flag)
NODE_ENV=development
# Razorpay TEST keys (https://dashboard.razorpay.com/app/keys). Leave empty to use the built-in demo checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Where the studio is on the map (default: Hyderabad). Used as the start of every delivery.
STUDIO_LAT=17.385
STUDIO_LNG=78.4867
# Folder for uploaded painting images
UPLOAD_DIR=uploads
